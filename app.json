{
  "expo": {
    "name": "Pretium",
    "slug": "Pretium",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pretium",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.michvista.pretium"
    },
    "android": {
      "package": "com.michvista.pretium",
      "adaptiveIcon": {
        "backgroundColor": "#0A0F2C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "development"
        }
      ],
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pretium uses your photo library to identify products from images.",
          "cameraPermission": "Pretium uses your camera to photograph products and find their prices."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBFAF6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 260
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "oneSignalAppId": "578229d0-cb74-4877-b17e-7de5db57b71d",
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "OneSignalNotificationServiceExtension",
                  "bundleIdentifier": "com.michvista.pretium.OneSignalNotificationServiceExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.michvista.pretium.onesignal"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "40b62376-75fe-4d65-9c3f-5ef6f4bd7c68"
      },
      "router": {}
    },
    "owner": "michelle29"
  }
}
